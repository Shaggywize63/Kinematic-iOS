# Fastfile — automated TestFlight / App Store delivery for Kinematic iOS.
#
# Runs headless in GitHub Actions (see .github/workflows/release-ios.yml) with:
#   • App Store Connect API key  → auth for signing + upload (no Apple ID/2FA)
#   • fastlane match             → distribution cert + provisioning profile,
#                                  stored encrypted in a private git repo
#
# The app is built with the iOS 26 SDK (Xcode 26) but ships a min deployment
# target of iOS 18, so it must build on a macos-26 runner.

default_platform(:ios)

APP_IDENTIFIER = "com.shaggywize63.kinematic".freeze
XCODE_PROJECT  = "Kinematic/Kinematic.xcodeproj".freeze
SCHEME         = "Kinematic".freeze
TEAM_ID        = "K7PLGT7499".freeze

# App Store Connect API key assembled from base64 secret — reused by every lane.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    in_house: false,
  )
end

# Unique, monotonic build number (App Store Connect rejects duplicates). The
# app's Info.plist reads CFBundleVersion from $(CURRENT_PROJECT_VERSION), so
# overriding it at archive time via xcargs flows straight into the binary.
def build_number
  Time.now.strftime("%Y%m%d%H%M")
end

def sign_and_build(bnum)
  match(
    type: "appstore",
    app_identifier: APP_IDENTIFIER,
    api_key: asc_api_key,
    # Not readonly: the build lane creates the distribution cert + profile on
    # first run and reuses them thereafter (match is idempotent). readonly:true
    # crashes if the repo has no usable identity yet ("cannot create ... readonly").
    readonly: false,
  )
  # Point the project at the match profile with manual signing for the archive.
  update_code_signing_settings(
    use_automatic_signing: false,
    path: XCODE_PROJECT,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    bundle_identifier: APP_IDENTIFIER,
    profile_name: "match AppStore #{APP_IDENTIFIER}",
    targets: [SCHEME],
  )
  build_app(
    project: XCODE_PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    xcargs: "CURRENT_PROJECT_VERSION=#{bnum}",
    export_options: {
      signingStyle: "manual",
      provisioningProfiles: { APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}" },
    },
  )
end

platform :ios do
  # One-time bootstrap (or when the cert expires / is revoked): create the
  # App Store distribution certificate + provisioning profile and store them
  # encrypted in the match git repo. Run via workflow_dispatch with lane=certs.
  desc "Create/refresh signing assets in the match repo"
  lane :certs do
    setup_ci
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: asc_api_key,
      readonly: false,
    )
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    setup_ci
    bnum = build_number
    sign_and_build(bnum)
    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
    UI.success("Uploaded build #{bnum} to TestFlight ✈️")
  end

  desc "Build and upload to App Store Connect (does NOT auto-submit for review)"
  lane :release do
    setup_ci
    bnum = build_number
    sign_and_build(bnum)
    upload_to_app_store(
      api_key: asc_api_key,
      submit_for_review: false,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true,
    )
    UI.success("Uploaded build #{bnum} to App Store Connect — finish metadata & submit in the ASC UI 🚀")
  end
end
