# Fastfile — automated TestFlight / App Store delivery for Kinematic iOS.
#
# Runs headless in GitHub Actions (see .github/workflows/release-ios.yml) with:
#   • App Store Connect API key  → auth for signing + upload (no Apple ID/2FA)
#   • fastlane match             → distribution cert + provisioning profile,
#                                  stored encrypted in a private git repo
#
# The app is built with the iOS 26 SDK (Xcode 26) but ships a min deployment
# target of iOS 18, so it must build on a macos-26 runner.

default_platform(:ios)

APP_IDENTIFIER = "com.shaggywize63.kinematic".freeze
XCODE_PROJECT  = "Kinematic/Kinematic.xcodeproj".freeze
SCHEME         = "Kinematic".freeze
# The App Store Connect API key is bound to exactly one Apple Developer team,
# and that is the team every cert / profile / App ID actually lives under. Keep
# this in sync with the key. sign_and_build additionally prefers the team match
# reports at runtime, so a drift here can't silently break the archive.
TEAM_ID        = "WQ25J762R4".freeze

# App Store Connect API key assembled from base64 secret — reused by every lane.
#
# We decode the base64 .p8 ourselves and hand fastlane the raw PEM
# (is_key_content_base64: false) rather than letting it decode. fastlane
# >= 2.236.0 has a regression on the base64 path: it writes a malformed .p8 for
# altool, so the TestFlight/App Store binary upload fails with
# "The file couldn't be opened because it isn't in the correct format. (259)"
# even though the spaceship auth (which reads the key correctly) succeeds.
# Passing already-decoded content sidesteps that buggy code entirely.
# Refs: fastlane/fastlane#30065, fastlane/fastlane#30066.
def asc_api_key
  require "base64"
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")),
    is_key_content_base64: false,
    in_house: false,
  )
end

# Short-lived ES256 JWT for the App Store Connect REST API, signed with the same
# .p8 key the signing/upload steps use (jwt + openssl ship with fastlane).
def asc_api_jwt
  require "base64"
  require "openssl"
  require "jwt"
  now = Time.now.to_i
  JWT.encode(
    { iss: ENV.fetch("ASC_ISSUER_ID"), iat: now, exp: now + 15 * 60, aud: "appstoreconnect-v1" },
    OpenSSL::PKey.read(Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))),
    "ES256",
    { kid: ENV.fetch("ASC_KEY_ID"), typ: "JWT" },
  )
end

def asc_api_request(method, path)
  require "net/http"
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  klass = method == :delete ? Net::HTTP::Delete : Net::HTTP::Get
  req = klass.new(uri)
  req["Authorization"] = "Bearer #{asc_api_jwt}"
  req["Accept"] = "application/json"
  Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req) }
end

# Revoke every App Store *distribution* certificate on the account. match mints a
# distribution cert on each bootstrap, but while the git store was unwritable it
# could never save the private key — so the account's two distribution slots
# filled with orphaned certs no machine can use, and match could no longer create
# the one it needs ("reached the maximum number of available Distribution
# certificates"). Revoking them (development certs are left untouched, and already
# uploaded/released builds stay valid) frees the slots so the next
# match(readonly:false) can mint AND persist a usable identity.
def revoke_distribution_certs
  require "json"
  res = asc_api_request(:get, "/v1/certificates?limit=200")
  UI.user_error!("Could not list certificates (HTTP #{res.code}): #{res.body}") unless res.code.to_i == 200
  certs = (JSON.parse(res.body)["data"] || []).select do |c|
    c.dig("attributes", "certificateType").to_s.include?("DISTRIBUTION")
  end
  if certs.empty?
    UI.message("No distribution certificates to revoke.")
    return
  end
  certs.each do |c|
    id   = c["id"]
    type = c.dig("attributes", "certificateType")
    name = c.dig("attributes", "name")
    del  = asc_api_request(:delete, "/v1/certificates/#{id}")
    if [200, 204].include?(del.code.to_i)
      UI.message("Revoked distribution certificate #{type} #{id} (#{name})")
    else
      UI.important("Failed to revoke #{id} (HTTP #{del.code}): #{del.body}")
    end
  end
end

# Unique, monotonic build number (App Store Connect rejects duplicates). The
# app's Info.plist reads CFBundleVersion from $(CURRENT_PROJECT_VERSION), so
# overriding it at archive time via xcargs flows straight into the binary.
def build_number
  Time.now.strftime("%Y%m%d%H%M")
end

def sign_and_build(bnum)
  match(
    type: "appstore",
    app_identifier: APP_IDENTIFIER,
    api_key: asc_api_key,
    readonly: true,
  )

  # Use the exact team + profile match just installed rather than guessing.
  # match/sigh export both as env vars, and they can legitimately differ from
  # the hard-coded defaults: the team is whatever the API key is bound to, and
  # when the base profile name is already taken on the portal match stores a
  # timestamped variant ("match AppStore <id> 1789616908"). Signing the archive
  # against a guessed name/team is exactly how a valid cert still fails export.
  team = ENV["sigh_#{APP_IDENTIFIER}_appstore_team-id"] || TEAM_ID
  profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"] || "match AppStore #{APP_IDENTIFIER}"

  # Point the project at the match profile with manual signing for the archive.
  update_code_signing_settings(
    use_automatic_signing: false,
    path: XCODE_PROJECT,
    team_id: team,
    code_sign_identity: "Apple Distribution",
    bundle_identifier: APP_IDENTIFIER,
    profile_name: profile_name,
    targets: [SCHEME],
  )
  # build_app (gym) returns the absolute path to the exported .ipa.
  build_app(
    project: XCODE_PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    xcargs: "CURRENT_PROJECT_VERSION=#{bnum}",
    export_options: {
      signingStyle: "manual",
      provisioningProfiles: { APP_IDENTIFIER => profile_name },
    },
  )
end

# Upload a built .ipa to App Store Connect via iTMSTransporter.
#
# altool on the Xcode 26 runner is broken: it fails to generate its auth JWT
# from a VALID App Store Connect API key ("Failed to generate JWT token: …
# isn't in the correct format. (259)"). This was proven not to be our key or a
# shadowing file — a diagnostic run showed the written .p8 parses via openssl,
# it sits alone on altool's key search path, and our own Ruby signer
# (asc_api_jwt) mints working tokens from it (the certs lane revoked certs with
# it). It is an Apple altool bug on this toolchain.
#
# iTMSTransporter (bundled with Xcode, separate Java JWT code) uploads the same
# build fine. It reads AuthKey_<id>.p8 from ./private_keys or the home key dirs;
# we write it to both and authenticate with -apiKey/-apiIssuer (Apple's forums
# report that path works where -jwt has regressed), falling back to a
# pre-generated JWT if that first attempt fails. A build uploaded this way lands
# in App Store Connect for both TestFlight testing and App Store submission.
def upload_ipa(ipa_path)
  require "base64"
  require "fileutils"
  UI.user_error!("No .ipa was produced to upload (got #{ipa_path.inspect})") if ipa_path.nil? || !File.exist?(ipa_path)

  key_id = ENV.fetch("ASC_KEY_ID")
  issuer = ENV.fetch("ASC_ISSUER_ID")
  key_bytes = Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
  home_keys = File.join(Dir.home, ".appstoreconnect", "private_keys")
  local_keys = File.join(Dir.pwd, "private_keys")
  [home_keys, local_keys].each do |d|
    FileUtils.mkdir_p(d)
    p = File.join(d, "AuthKey_#{key_id}.p8")
    File.write(p, key_bytes)
    File.chmod(0o600, p)
  end
  ENV["API_PRIVATE_KEYS_DIR"] = home_keys

  # DIAG: which Xcodes (hence altool binaries) exist on the runner, so if the
  # upload fails we know whether a non-26 altool is available to fall back to.
  sh("bash", "-lc", "for x in /Applications/Xcode*.app; do echo \"XCODE: $x -> $(\"$x/Contents/Developer/usr/bin/xcodebuild\" -version 2>/dev/null | head -1)\"; done; echo 'ALTOOL BINARIES:'; ls -1 /Applications/Xcode*.app/Contents/Developer/usr/bin/altool 2>/dev/null || true") rescue nil

  # iTMSTransporter is now just a stub on Xcode 26 ("install Transporter from the
  # Mac App Store"), so it is not usable here. Use altool's NEW transport path
  # (no --use-old-altool): only the legacy path was tested with a valid key so
  # far, and it failed JWT generation — the new path is the last bundled option.
  UI.message("Uploading #{File.basename(ipa_path)} to App Store Connect via altool…")
  sh(
    "xcrun", "altool", "--upload-app",
    "-f", ipa_path,
    "-t", "ios",
    "--apiKey", key_id,
    "--apiIssuer", issuer,
  )
ensure
  Dir.glob(File.join(Dir.home, ".appstoreconnect", "private_keys", "AuthKey_*.p8")).each { |f| File.delete(f) rescue nil }
  Dir.glob(File.join(Dir.pwd, "private_keys", "AuthKey_*.p8")).each { |f| File.delete(f) rescue nil }
end

platform :ios do
  # One-time bootstrap (or when the cert expires / is revoked): create the
  # App Store distribution certificate + provisioning profile and store them
  # encrypted in the match git repo. Run via workflow_dispatch with lane=certs.
  desc "Create/refresh signing assets in the match repo"
  lane :certs do
    setup_ci
    # Clear orphaned distribution certs (see revoke_distribution_certs) so the
    # create below is never blocked by Apple's 2-distribution-cert cap. This is
    # a manual bootstrap lane, so revoke-then-create is exactly its job.
    revoke_distribution_certs
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: asc_api_key,
      readonly: false,
    )
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    setup_ci
    bnum = build_number
    ipa = sign_and_build(bnum)
    upload_ipa(ipa)
    UI.success("Uploaded build #{bnum} to App Store Connect — it will appear in TestFlight after processing ✈️")
  end

  desc "Build and upload to App Store Connect (does NOT auto-submit for review)"
  lane :release do
    setup_ci
    bnum = build_number
    ipa = sign_and_build(bnum)
    upload_ipa(ipa)
    UI.success("Uploaded build #{bnum} to App Store Connect — finish metadata & submit in the ASC UI 🚀")
  end
end
